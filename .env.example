JWT_SECRET = 'some hard to guess string'
NODE_ENV = 'NODE_ENV'
FRONTEND_URL = 'FRONTEND_URL'
ALLOWED_ORIGINS = 'ALLOWED_ORIGINS'

MONGO_DB_CONNECT_STRING = 'CONNECT_STRING'

# PostgreSQL Database Connection
DATABASE_URL = "DATABASE_URL"

# Database SSL and Timeout Configuration
# Format: sslmode=require&statement_timeout=15000
# Customizable per environment for flexibility
DATABASE_SSL_TIMEOUT_OPTIONS = "DATABASE_SSL_TIMEOUT_OPTIONS"

RESEND_API_KEY = 'RESEND_API_KEY'

# Monitoring Provider: 'sentry' (default) or 'xray'
MONITORING_PROVIDER = 'sentry'
SENTRY_DSN = 'SENTRY_DSN'

# OpenTelemetry / AWS X-Ray Configuration (only used when MONITORING_PROVIDER=xray)
# https://docs.aws.amazon.com/AmazonCloudWatch/latest/monitoring/CloudWatch-OTLP-UsingADOT.html
# IMPORTANT: When using X-Ray, add this flag to your npm scripts:
# "start": "node --require dotenv/config --require @aws/aws-distro-opentelemetry-node-autoinstrumentation/register index.js",
# "dev": "nodemon --require dotenv/config --require @aws/aws-distro-opentelemetry-node-autoinstrumentation/register index.js",
# "staging": "nodemon --require dotenv/config --require @aws/aws-distro-opentelemetry-node-autoinstrumentation/register index.js",
# "prod": "node --require dotenv/config --require @aws/aws-distro-opentelemetry-node-autoinstrumentation/register index.js",
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://xray.us-east-1.amazonaws.com/v1/traces
OTEL_RESOURCE_ATTRIBUTES=service.name=backend-boilerplate
OTEL_METRICS_EXPORTER=none
OTEL_NODE_ENABLED_INSTRUMENTATIONS=none
OTEL_LOG_LEVEL=error

AWS_ACCESS_KEY_ID = "AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY = "AWS_SECRET_ACCESS_KEY"
AWS_BUCKET = "AWS_BUCKET"
AWS_BUCKET_REGION = "AWS_BUCKET_REGION"
AWS_ACCOUNT_ID = "AWS_ACCOUNT_ID"
AWS_REGION = "AWS_REGION"

# AWS Secrets Manager Configuration
# RDS Secret Name/ARN for retrieving database credentials dynamically
RDS_SECRET_NAME="RDS_SECRET_NAME"


# Redis Configuration
REDIS_HOST = "REDIS_HOST"
REDIS_PORT = "REDIS_PORT"
REDIS_USERNAME = "REDIS_USERNAME"
REDIS_PASSWORD = "REDIS_PASSWORD"
# Set to true when the server requires TLS (e.g. ElastiCache/Valkey with
# in-transit encryption enabled). Leave false for local plaintext Redis.
REDIS_TLS = "false"
# Set to true when connecting to an ElastiCache/Valkey "cluster mode enabled"
# cluster (uses the ioredis Cluster client). Leave false for single-node.
REDIS_CLUSTER = "false"
# In cluster mode the prefix MUST be wrapped in curly braces so all of a
# queue's keys hash to the same slot, e.g. {preventatri}. Otherwise BullMQ
# throws CROSSSLOT errors.
BULL_PREFIX = "BULL_PREFIX"

STRIPE_SECRET_KEY = "STRIPE_SECRET_KEY"
STRIPE_ACCOUNT_WEBHOOK_SECRET = "STRIPE_ACCOUNT_WEBHOOK_SECRET"
STRIPE_CONNECT_WEBHOOK_SECRET = "STRIPE_CONNECT_WEBHOOK_SECRET"

TWILIO_ACCOUNT_SID = "TWILIO_ACCOUNT_SID"
TWILIO_AUTH_TOKEN = "TWILIO_AUTH_TOKEN"
TWILIO_PHONE_NUMBER = "TWILIO_PHONE_NUMBER"

SENDGRID_API_KEY = 'SENDGRID_API_KEY'

DEFAULT_DEV_OTP = "DEFAULT_DEV_OTP"

# Enable detailed query logging for development
DATABASE_LOG_QUERIES="DATABASE_LOG_QUERIES"













# HHAX Configuration (HHAeXchange one-way patient sync)
# Credentials come from the HHAeXchange integration portal.
# HHAX_BASE_URL is the sandbox endpoint below for dev/staging; production uses
# the live tenant URL and a separate credential set.
HHAX_APP_NAME=HHAX_APP_NAME
HHAX_APP_SECRET=HHAX_APP_SECRET
HHAX_APP_KEY=HHAX_APP_KEY
# The one organization HHAeXchange is connected to. Only its members can use the
# HHAeXchange APIs, and the nightly sync imports into it. Leave empty and
# HHAeXchange is off for everyone, and the nightly sync does nothing.
HHAX_ORGANIZATION_ID=
HHAX_BASE_URL='https://app2sandbox.hhaexchange.com/Integration/ENT/V1.8/ws.asmx'

# Super admin seed. When both are set, `npx prisma db seed` creates the super admin
# and the organization it lives in (it does nothing if the email already exists).
# Put the real values in your own .env only, never in this file.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Optional: SUPER_ADMIN_ORGANIZATION_NAME, SUPER_ADMIN_FIRST_NAME, SUPER_ADMIN_LAST_NAME
